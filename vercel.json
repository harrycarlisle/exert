{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd LitterLogWeb && npm ci && npm run build",
  "outputDirectory": "LitterLogWeb/dist",
  "installCommand": "cd LitterLogWeb && npm ci",
  "framework": null,
  "rewrites": [{ "source": "/((?!assets/|icons/|sw\\.js|workbox|manifest).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
